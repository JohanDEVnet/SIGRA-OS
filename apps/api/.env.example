PORT=3001
HOST=127.0.0.1
# Vercel defaults to 0.0.0.0 if HOST is absent/empty; do not copy this local HOST there.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional HTTP key. Keep empty for the public website; never embed a secret in React.
API_KEY=

# Persistent public-data cache. Configure both variables only on the Nest server.
# Apply supabase/migrations/202610120001_public_cache.sql first.
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR_CON_LA_CLAVE_REAL
# Legacy service_role JWT is also supported via SUPABASE_SERVICE_ROLE_KEY.
# Never use anon/publishable keys here or VITE_ prefixes for server secrets.
